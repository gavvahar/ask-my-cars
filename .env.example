# Postgres (used both by the app and the seed/build-embeddings scripts)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ask_my_cars
POSTGRES_USER=ask_my_cars
POSTGRES_PASSWORD=

# Self-hosted Ollama instance. OLLAMA_BASE_URL defaults to the project's own
# instance if unset -- override if you're running your own.
OLLAMA_BASE_URL=http://192.168.1.14:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_GENERATION_MODEL=qwen2.5:7b

# Optional: seconds before POST /api/ask gives up and returns a 504.
# Defaults to 120 if unset.
ASK_TIMEOUT_SECONDS=120
